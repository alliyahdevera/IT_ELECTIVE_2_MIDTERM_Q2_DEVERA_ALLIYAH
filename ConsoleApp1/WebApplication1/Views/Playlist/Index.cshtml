@model List<WebApplication1.Models.Entities.Playlist>

@{
    ViewData["Title"] = "My Playlists";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-4 fw-bold">Playlist</h1>
            <p class="text-muted mb-0">
                Welcome,
                <strong>@ViewBag.Username!</strong>
            </p>
        </div>

        <div>
            <a asp-controller="Playlist"
               asp-action="Create"
               class="btn btn-success">
                + Create Playlist
            </a>

            <a asp-controller="Auth"
               asp-action="Logout"
               class="btn btn-outline-danger">
                Logout
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No playlists available.
        </div>
    }
    else
    {
        @foreach (var playlist in Model)
        {
            <div class="card mb-4">

                <div class="card-body p-4">

                    <h3 class="fw-bold">
                        @playlist.Title
                    </h3>

                    <p class="text-muted mb-4">
                        Created by @playlist.CreatorName
                    </p>

                    <table class="table table-borderless align-middle">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Track</th>
                                <th>Notes</th>
                            </tr>

                        </thead>

                        <tbody>

                            @for (int i = 0; i < playlist.Videos.Count; i++)
                            {
                                <tr>

                                    <td>@(i + 1)</td>

                                    <td>
                                        <a href="@playlist.Videos[i].YouTubeUrl"
                                           target="_blank"
                                           class="text-success text-decoration-none fw-semibold">
                                            🔗 View Video
                                        </a>
                                        <br />
                                        <small class="text-muted">
                                            @playlist.Videos[i].YouTubeUrl
                                        </small>
                                    </td>

                                    <td>
                                        @playlist.Videos[i].TrackNote
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }
