@model WebApplication1.Models.DTOs.LoginDto

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-white">Playlistify</h1>
            <p class="text-muted">Sign in to continue</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form asp-action="Login" method="post">

            <div class="mb-3">
                <label asp-for="Username" class="form-label text-white"></label>
                <input asp-for="Username" class="form-control" placeholder="Enter username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label text-white"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">
                Login
            </button>

        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                Hint: <strong>admin</strong> / <strong>password123</strong>
            </small>
        </div>

    </div>

</div>